# Database (Vercel Postgres / Neon)
DATABASE_URL="postgresql://user:password@host:5432/budget?sslmode=require"

# Auth.js — generate secret: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# Single-user login (no public sign-up)
AUTH_USER_EMAIL="you@example.com"
# Generate hash: npm run db:hash-password -- yourpassword
# Use B64 (plain AUTH_USER_PASSWORD_HASH breaks in Next.js due to $ expansion)
AUTH_USER_PASSWORD_HASH_B64=""
